# The phone page. Long-running, restarted if it ever dies.
[Unit]
Description=Daily sheet phone server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/daily-sheet
ExecStart=/opt/daily-sheet/.venv/bin/python serve.py --host 0.0.0.0 --port 8080 --quiet
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
