# Outlook published ICS feed ("titles and locations" level).
# Treat this as a secret: anyone with the URL can read your calendar.
ICS_URL=

# Calendar written by Power Automate and synced down by OneDrive. Takes
# precedence over ICS_URL — use it when Outlook only publishes free/busy.
CALENDAR_JSON=

# Asana personal access token — https://app.asana.com/0/my-apps
ASANA_PAT=

# The pipeline board the Projects page reads. Cards on it are kept off Tasks.
ASANA_BOARD=Incoming + active projects

# Anthropic API key — used only to transcribe handwriting
ANTHROPIC_API_KEY=

# rmapi binary and the folder on the tablet
RMAPI_BIN=rmapi
REMARKABLE_FOLDER=Daily

# Shared token for the phone server (serve.py). Anything that reaches the
# server can write to Asana and push to the tablet, so it is checked on every
# request. Make one up — long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# Leave it blank and the server invents one per restart and prints it.
WEB_TOKEN=

# Ink thresholds — tune with `python -m daily_sheet calibrate` (SCOPE §6.4)
# INK_CHECK_MIN=0.035
# INK_SPAN_MIN=0.45
