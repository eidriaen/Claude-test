# Outlook published ICS feed ("titles and locations" level).
# Treat this as a secret: anyone with the URL can read your calendar.
ICS_URL=

# Calendar written by Power Automate and synced down by OneDrive. Takes
# precedence over ICS_URL — use it when Outlook only publishes free/busy.
CALENDAR_JSON=

# Asana personal access token — https://app.asana.com/0/my-apps
ASANA_PAT=

# The pipeline board the Projects page reads. Cards on it are kept off Tasks.
ASANA_BOARD=Incoming + active projects

# Anthropic API key — used only to transcribe handwriting
ANTHROPIC_API_KEY=

# Trello — the shared personal board behind the Personal page. Both come from
# https://trello.com/power-ups/admin (make a Power-Up, copy its API key, then
# use the "Token" link next to it). README: "Personal tasks from Trello".
TRELLO_KEY=
TRELLO_TOKEN=
# Board name. Leave blank if the token sees exactly one board.
TRELLO_BOARD=
# Ticked cards move here (default "Done"); without such a list they are archived.
TRELLO_DONE_LIST=Done
# Where handwritten lines from the Personal page land. Default: the first list.
TRELLO_INBOX_LIST=
# Which lists the page shows, comma-separated, in this order. Blank = every
# list. Emoji and punctuation in list names are ignored when matching.
TRELLO_LISTS=
# Print a different name than the Trello display name: "Trello name:printed name".
TRELLO_NAMES=
# The lists the TW / NW / NM boxes move a card to.
TRELLO_LIST_THIS_WEEK=To-do this week
TRELLO_LIST_NEXT_WEEK=To-do next week
TRELLO_LIST_NEXT_MONTH=To-do next month

# rmapi binary and the folders on the tablet. Past days are moved into
# REMARKABLE_ARCHIVE (a subfolder of REMARKABLE_FOLDER), never deleted.
RMAPI_BIN=rmapi
REMARKABLE_FOLDER=Daily
REMARKABLE_ARCHIVE=Archived dailies

# Shared token for the phone server (serve.py). Anything that reaches the
# server can write to Asana and push to the tablet, so it is checked on every
# request. Make one up — long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# Leave it blank and the server invents one per restart and prints it.
WEB_TOKEN=

# Ink thresholds — tune with `python -m daily_sheet calibrate` (SCOPE §6.4)
# INK_CHECK_MIN=0.035
# INK_SPAN_MIN=0.45
